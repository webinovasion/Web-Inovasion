---
import { siteData } from '../data/site';

const [profilePackage, companyPackage, catalogPackage] = siteData.packages;
const officialServices = siteData.services.map(({ name }) => name).join(', ');

const faqs = [
  {
    q: 'Jenis website apa yang bisa dibuat?',
    a: `Saya mengerjakan ${officialServices}. Fitur khusus dibahas berdasarkan kebutuhan dan lingkup proyek.`,
  },
  {
    q: 'Berapa harga pembuatan website?',
    a: `${profilePackage.name} ${profilePackage.price}, ${companyPackage.name} ${companyPackage.price}, dan ${catalogPackage.name} ${catalogPackage.price}. Landing Page ${siteData.landingPagePrice}; fiturnya dibahas sebagai lingkup tersendiri.`,
  },
  {
    q: 'Berapa lama pengerjaannya?',
    a: 'Estimasi pengerjaan mulai 7 hari kerja setelah materi lengkap dan lingkup disepakati. Durasi bergantung pada jumlah halaman, fitur, dan kecepatan persetujuan revisi. Jadwal dikonfirmasi sebelum mulai.',
  },
  {
    q: 'Apakah domain dan hosting termasuk?',
    a: `Domain .com dan shared hosting termasuk untuk tahun pertama. Perpanjangan diperkirakan ${siteData.renewal.annualDisplay} untuk dua komponen tersebut dan mengikuti tagihan provider saat itu. Hosting bersama dikelola Web Inovasion; akses cPanel utama tidak dibagikan.`,
  },
  {
    q: 'Bisakah saya mengubah konten sendiri?',
    a: `${catalogPackage.name} menyediakan dashboard untuk mengelola katalog sesuai lingkup yang disepakati. Untuk website tanpa dashboard, perubahan konten dapat diminta sebagai pekerjaan tambahan.`,
  },
  {
    q: 'Berapa kali revisi yang didapat?',
    a: 'Profil Bisnis mencakup 2 putaran revisi dan paket Company Profile mencakup 3 putaran revisi. Revisi adalah penyesuaian pada desain atau isi sesuai lingkup yang disepakati; penambahan halaman atau fitur ditawarkan terpisah.',
  },
  {
    q: 'Apakah website dibuat dengan SEO?',
    a: 'Paket tertentu mencakup SEO on-page dasar. Detail teknis dan konten yang dikerjakan mengikuti paket; tidak ada jaminan posisi tertentu di hasil pencarian.',
  },
];

const WA_NUMBER = siteData.contact.phone.replace('+', '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': 'https://webinovasion.com/#faq',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<section id="faq" aria-labelledby="faq-heading" class="bg-white py-20 lg:py-28">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.8fr] gap-16 items-start">
      <div class="lg:sticky lg:top-24">
        <div class="mb-4 inline-flex items-center gap-2">
          <span class="text-xs font-bold tracking-[0.16em] text-brand uppercase"> FAQ </span>
        </div>

        <h2
          id="faq-heading"
          class="text-3xl lg:text-4xl font-extrabold tracking-tight
         text-ink-primary leading-tight mb-3"
        >
          Pertanyaan tentang Website dan Layanan
        </h2>

        <p class="text-base text-ink-secondary leading-relaxed mb-8">
          Informasi paket, waktu pengerjaan, revisi, dan fitur yang sering ditanyakan sebelum proyek dimulai.
        </p>

        <div class="rounded-xl border border-surface-border bg-surface-base p-5">
          <p class="text-sm text-ink-secondary leading-relaxed mb-3">
            Masih punya pertanyaan tentang layanan atau kebutuhan website bisnis Anda?
          </p>
          <a
            href={`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent('Halo Web Inovasion, saya ingin bertanya seputar layanan website.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm
                   font-semibold text-brand transition-[gap]
                   duration-200 hover:gap-3"
          >
            Tanya via WhatsApp
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-2" id="faqList">
        {faqs.map((faq, i) => (
          <div
            class="faq-item group overflow-hidden rounded-xl border border-surface-border
                   bg-white
                   transition-colors duration-250"
            data-index={i}
          >
            <button
              class="faq-btn flex w-full items-center justify-between
                     gap-4 px-5 py-[18px] text-left"
              aria-expanded="false"
            >
              <span
                class="text-sm font-semibold text-ink-primary
                           leading-snug"
              >
                {faq.q}
              </span>
              <div
                class="faq-icon flex h-7 w-7 flex-shrink-0
                          items-center justify-center rounded-lg
                          bg-surface-card transition-all duration-300"
              >
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#64748B"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </div>
            </button>

            <div
              class="faq-body max-h-0 overflow-hidden
                        transition-[max-height] duration-[350ms]
                        ease-in-out"
            >
              <div
                class="border-t border-surface-card px-5 pb-5 pt-3.5
                          text-sm leading-[1.8] text-ink-secondary"
              >
                {faq.a}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const items = document.querySelectorAll<HTMLElement>('.faq-item');

  items.forEach((item) => {
    const btn = item.querySelector<HTMLButtonElement>('.faq-btn')!;
    const body = item.querySelector<HTMLElement>('.faq-body')!;
    const icon = item.querySelector<HTMLElement>('.faq-icon')!;

    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Tutup semua
      items.forEach((el) => {
        const b = el.querySelector<HTMLButtonElement>('.faq-btn')!;
        const d = el.querySelector<HTMLElement>('.faq-body')!;
        const ic = el.querySelector<HTMLElement>('.faq-icon')!;
        b.setAttribute('aria-expanded', 'false');
        d.style.maxHeight = '0';
        el.style.borderColor = '';
        ic.style.transform = '';
        ic.style.background = '';
      });

      // Buka yang diklik kalau sebelumnya tertutup
      if (!isOpen) {
        btn.setAttribute('aria-expanded', 'true');
        body.style.maxHeight = body.scrollHeight + 'px';
        item.style.borderColor = 'rgba(15,118,110,0.25)';
        icon.style.transform = 'rotate(180deg)';
        icon.style.background = 'rgba(15,118,110,0.1)';
      }
    });
  });
</script>
