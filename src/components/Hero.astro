---
import projects from '../data/projects';

const featuredProject = projects[0];
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="overflow-hidden bg-white py-14 pb-20 sm:py-20 sm:pb-24 lg:py-24 lg:pb-28"
>
  <div class="container-custom grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-brand">
        Website untuk bisnis teknik dan industri
      </p>
      <h1
        id="hero-heading"
        class="max-w-2xl text-4xl font-extrabold leading-[1.08] tracking-tight text-ink-primary sm:text-5xl lg:text-6xl"
      >
        Website yang <span class="text-brand-light">meyakinkan</span> untuk perusahaan teknik dan industri
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-ink-secondary lg:text-lg">
        Tampilkan kapabilitas, layanan, produk, dan proyek dengan lebih jelas agar calon klien dan mitra mudah memahami
        bisnis Anda dan menghubungi Anda. Saya membantu kontraktor, supplier, dan perusahaan industri membangun company
        profile yang profesional.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded-lg bg-brand px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-hover"
        >
          Konsultasi via WhatsApp
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </a>
        <a
          href="#portfolio"
          class="inline-flex items-center rounded-lg border border-surface-border px-5 py-3 text-sm font-semibold text-ink-primary transition hover:border-brand hover:text-brand"
        >
          Lihat proyek
        </a>
      </div>
      <p class="mt-6 text-xs leading-relaxed text-ink-muted">
        <strong class="font-semibold text-ink-primary">Pengalaman proyek di bidang teknik dan industri.</strong> Lihat
        contoh hasil pekerjaan saya.
      </p>
    </div>

    <article class="relative mx-auto w-full max-w-2xl lg:ml-auto">
      <div
        class="absolute -right-5 -top-5 h-28 w-28 rounded-3xl bg-brand-light/15 sm:-right-7 sm:-top-7 sm:h-36 sm:w-36"
        aria-hidden="true"
      ></div>
      <div class="relative overflow-hidden rounded-2xl border border-surface-border bg-white p-2 shadow-card sm:rounded-3xl sm:p-3">
        <div class="flex h-9 items-center gap-1.5 border-b border-surface-border px-3 sm:h-10">
          <span class="h-2 w-2 rounded-full bg-rose-300" aria-hidden="true"></span>
          <span class="h-2 w-2 rounded-full bg-amber-300" aria-hidden="true"></span>
          <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
          <span class="ml-auto text-[10px] font-semibold uppercase tracking-widest text-ink-muted">Contoh proyek</span>
        </div>
        <a
          href={featuredProject.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Kunjungi website ${featuredProject.nama}`}
          class="block overflow-hidden rounded-b-xl bg-surface-card sm:rounded-b-2xl"
        >
          <img
            src={featuredProject.gambar}
            alt={`Tampilan website ${featuredProject.nama}`}
            width="900"
            height="620"
            fetchpriority="high"
            decoding="async"
            class="aspect-[4/3] w-full object-cover object-top transition-transform duration-700 hover:scale-[1.02]"
          />
        </a>
      </div>
      <div class="relative mt-4 flex items-end justify-between gap-4 rounded-xl border border-surface-border bg-white p-4 shadow-card sm:absolute sm:-bottom-6 sm:left-6 sm:mt-0 sm:max-w-[80%] sm:p-5">
        <div>
          <p class="mb-1 text-[10px] font-bold uppercase tracking-[0.16em] text-brand">{featuredProject.jenis}</p>
          <h2 class="font-bold text-ink-primary sm:text-lg">{featuredProject.nama}</h2>
          <p class="mt-1 text-xs leading-relaxed text-ink-secondary">{featuredProject.solusi}</p>
        </div>
        <a
          href="#portfolio"
          aria-label="Lihat semua proyek"
          class="mb-1 shrink-0 text-xl font-semibold text-brand transition-transform hover:translate-x-1"
        >
          →
        </a>
      </div>
    </article>
  </div>
</section>
