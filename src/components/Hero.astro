---
import projects from '../data/Projects.json';

const featuredProject = projects[0];
---

<section id="hero" aria-labelledby="hero-heading" class="relative py-20 lg:py-28 bg-hero overflow-hidden">
  <!-- ── Background Layers: Tech Blueprint Grid + Ambient Radial Glow (0 Lag, No Blur Filters) ── -->
  <div class="pointer-events-none absolute inset-0 select-none overflow-hidden" aria-hidden="true">
    <!-- Ambient Radial Glow 1 (Top right / behind visual) -->
    <div
      class="absolute -top-24 -right-20 h-[620px] w-[620px]"
      style="background: radial-gradient(circle at 60% 40%, rgba(15, 118, 110, 0.13) 0%, rgba(20, 184, 166, 0.04) 50%, transparent 72%);"
    ></div>

    <!-- Ambient Radial Glow 2 (Left / accent glow) -->
    <div
      class="absolute top-1/4 -left-28 h-[520px] w-[520px]"
      style="background: radial-gradient(circle at 50% 50%, rgba(20, 184, 166, 0.08) 0%, transparent 68%);"
    ></div>

    <!-- Subtle Blueprint Grid with Radial Masking -->
    <div
      class="absolute inset-0 opacity-[0.35]"
      style="background-image: linear-gradient(to right, rgba(15, 118, 110, 0.12) 1px, transparent 1px), linear-gradient(to bottom, rgba(15, 118, 110, 0.12) 1px, transparent 1px); background-size: 36px 36px; mask-image: radial-gradient(ellipse 75% 65% at 50% 35%, black 20%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 35%, black 20%, transparent 80%);"
    ></div>
  </div>

  <div class="container-custom relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- ── Konten kiri ───────────────────── -->
      <div class="animate-fade-up">
        <!-- Badge -->
        <div
          class="inline-flex items-center gap-2 rounded-full
            border border-brand-border bg-brand-muted
            px-3 py-1.5 mb-6"
        >
          <span class="block h-1.5 w-1.5 rounded-full bg-brand animate-pulse-slow" aria-hidden="true"></span>

          <span class="text-xs font-semibold text-brand tracking-wide"> Website untuk kebutuhan bisnis </span>
        </div>

        <!-- H1 — satu per halaman, keyword di depan -->
        <h1
          id="hero-heading"
          class="text-4xl lg:text-5xl xl:text-[3.25rem]
         font-extrabold leading-[1.1] tracking-tight
         text-ink-primary"
        >
          Jasa Pembuatan Website
          <br />
          untuk <em class="not-italic text-brand">UMKM dan Bisnis</em>
        </h1>

        <p class="mt-5 text-base leading-relaxed text-ink-secondary max-w-lg">
          Pilih website company profile, landing page, toko online, atau website custom. Kami mulai dari tujuan bisnis,
          fitur yang dibutuhkan, dan anggaran, lalu menyepakati ruang lingkup sebelum pengerjaan.
        </p>

        <!-- CTA buttons -->
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#contact"
            class="inline-flex items-center gap-2 rounded-xl
                   bg-brand px-5 py-3 text-sm font-semibold text-white
                   transition hover:bg-brand-hover group"
          >
            Konsultasi Gratis
            <!-- Arrow right SVG -->
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="transition-transform group-hover:translate-x-1"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <a
            href="#portfolio"
            class="inline-flex items-center gap-2 rounded-xl
                   border border-surface-border bg-surface-raised
                   px-5 py-3 text-sm font-medium text-ink-primary
                   transition hover:border-brand hover:text-brand"
          >
            Lihat Portfolio
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </a>
        </div>

        <!-- Trust signal -->
        <div class="mt-10 flex items-center gap-3.5">
          <div class="text-xs text-ink-secondary leading-relaxed">
            <span><strong class="font-semibold text-ink-primary">{projects.length} contoh proyek</strong> tersedia di portfolio kami.</span>
          </div>
        </div>
      </div>

      <!-- Featured portfolio project -->
      <div class="hidden lg:block animate-fade-in">
        <article class="overflow-hidden rounded-3xl border border-surface-border bg-surface-raised shadow-card">
          <a href={featuredProject.url} target="_blank" rel="noopener noreferrer" aria-label={`Kunjungi website ${featuredProject.title}`}>
            <img
              src={featuredProject.image}
              alt={`Tampilan website ${featuredProject.title}`}
              width="640"
              height="360"
              fetchpriority="high"
              decoding="async"
              class="aspect-[16/10] w-full object-cover object-top"
            />
          </a>
          <div class="flex items-end justify-between gap-6 p-6">
            <div>
              <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-brand">Contoh proyek</p>
              <h2 class="text-xl font-bold text-ink-primary">{featuredProject.title}</h2>
              <p class="mt-2 max-w-sm text-sm leading-relaxed text-ink-secondary">{featuredProject.description}</p>
            </div>
            <a
              href="#portfolio"
              class="shrink-0 rounded-lg border border-surface-border px-4 py-2 text-sm font-semibold text-ink-primary transition hover:border-brand hover:text-brand"
            >
              Lihat proyek
            </a>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
