
---
import pricing from '../data/Pricing.json';

const whatsappNumber = '6285881582774';

const sharedBenefits = [
  {
    title: 'Desain Responsif',
    description: 'Tampilan menyesuaikan perangkat HP, tablet, dan desktop.',
  },
  {
    title: 'Optimasi Teknis Dasar',
    description: 'Struktur website dibuat dengan memperhatikan performa dan kemudahan penggunaan.',
  },
  {
    title: 'Konsultasi Awal Gratis',
    description: 'Diskusikan kebutuhan dan ruang lingkup proyek sebelum mulai.',
  },
  {
    title: 'Revisi Sesuai Paket',
    description: 'Jumlah dan cakupan revisi mengikuti ketentuan paket yang dipilih.',
  },
  {
    title: 'Panduan Penggunaan',
    description: 'Informasi pengelolaan website diberikan sesuai jenis paket dan fiturnya.',
  },
  {
    title: 'Dukungan Teknis',
    description: 'Dukungan setelah pengerjaan mengikuti masa garansi atau pemeliharaan paket.',
  },
];
---

<section
  id="harga"
  aria-labelledby="pricing-heading"
  class="bg-surface-raised py-20 lg:py-28"
>
  <div class="container-custom">
    <div
      class="mb-4 inline-flex items-center gap-1.5 rounded-full
             border border-brand-border bg-brand-muted px-3 py-1"
    >
      <span class="text-[11px] font-bold uppercase tracking-widest text-brand">
        Investasi
      </span>
    </div>

    <h2
      id="pricing-heading"
      class="mb-3 text-3xl font-extrabold leading-tight tracking-tight
             text-ink-primary lg:text-4xl"
    >
      Pilih Paket Sesuai Kebutuhan
    </h2>

    <p class="mb-10 max-w-2xl text-base leading-relaxed text-ink-secondary lg:mb-14">
      Mulai dari portfolio pribadi hingga website profesional untuk bisnis.
      Konsultasi gratis untuk membantu menentukan solusi yang sesuai dengan
      kebutuhan dan anggaran Anda.
    </p>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-6 lg:gap-6">
      {
        pricing.map((tier, index) => {
          const message = [
            'Halo Web Inovasion, saya tertarik dengan paket website berikut.',
            '',
            `Paket: ${tier.name}`,
            `Harga: ${tier.price}`,
            `Keterangan: ${tier.priceNote}`,
            '',
            'Boleh saya konsultasi mengenai detail fitur, ruang lingkup pengerjaan, dan biaya tambahan jika ada?',
          ].join('\n');

          const whatsappUrl =
            `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`;

          return (
            <article
              class:list={[
                'relative flex h-full flex-col rounded-2xl border p-6',
                'transition-all duration-300 hover:-translate-y-1',
                'lg:p-7',
                index >= 3 ? 'lg:col-span-3' : 'lg:col-span-2',
                tier.popular
                  ? 'border-brand bg-brand shadow-glow-sm'
                  : 'border-surface-border bg-surface-base hover:shadow-card',
              ]}
            >
              {tier.popular && (
                <span
                  class="absolute -top-3 left-1/2 -translate-x-1/2
                         whitespace-nowrap rounded-full bg-ink-primary
                         px-4 py-1.5 text-[10px] font-bold tracking-wide text-white"
                >
                  Paling Direkomendasikan
                </span>
              )}

              <div class="mb-5">
                <p
                  class:list={[
                    'mb-2 text-sm font-bold',
                    tier.popular ? 'text-white/85' : 'text-ink-muted',
                  ]}
                >
                  {tier.name}
                </p>

                <p
                  class:list={[
                    'text-3xl font-extrabold leading-tight tracking-tight lg:text-[2rem]',
                    tier.popular ? 'text-white' : 'text-ink-primary',
                  ]}
                >
                  {tier.price}
                </p>

                <p
                  class:list={[
                    'mt-2 text-xs leading-relaxed',
                    tier.popular ? 'text-white/75' : 'text-ink-secondary',
                  ]}
                >
                  {tier.priceNote}
                </p>
              </div>

              <div
                class:list={[
                  'mb-5 h-px',
                  tier.popular ? 'bg-white/20' : 'bg-surface-border',
                ]}
              />

              <ul class="mb-7 flex flex-1 flex-col gap-3" role="list">
                {tier.features.map((feature) => (
                  <li
                    class:list={[
                      'flex items-start gap-2.5 text-sm leading-relaxed',
                      tier.popular ? 'text-white/95' : 'text-ink-secondary',
                    ]}
                  >
                    <svg
                      width="17"
                      height="17"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke={tier.popular ? '#FFFFFF' : '#0F766E'}
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="mt-0.5 flex-shrink-0"
                      aria-hidden="true"
                    >
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>

              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Konsultasi WhatsApp untuk paket ${tier.name}`}
                class:list={[
                  'mt-auto block rounded-xl px-4 py-3 text-center',
                  'text-sm font-bold transition-colors duration-200',
                  tier.popular
                    ? 'bg-white text-brand hover:bg-teal-50'
                    : 'border border-surface-border bg-surface-raised text-brand hover:border-brand hover:bg-brand-muted',
                ]}
              >
                {tier.cta}
                <span class="ml-1" aria-hidden="true">→</span>
              </a>
            </article>
          );
        })
      }
    </div>

    <div class="mt-14">
      <div class="mb-6 max-w-2xl">
        <p class="mb-2 text-xs font-bold uppercase tracking-widest text-brand">
          Standar Pengerjaan
        </p>

        <h3 class="mb-3 text-2xl font-extrabold tracking-tight text-ink-primary">
          Dukungan untuk Website Anda
        </h3>

        <p class="text-sm leading-relaxed text-ink-secondary">
          Setiap proyek memiliki ruang lingkup berbeda. Berikut standar
          pengerjaan yang menjadi perhatian kami, dengan detail mengikuti
          paket dan kesepakatan proyek.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          sharedBenefits.map((benefit) => (
            <div class="flex items-start gap-3 rounded-xl border border-surface-border bg-surface-base p-5">
              <div
                class="flex h-10 w-10 flex-shrink-0 items-center justify-center
                       rounded-xl border border-brand-border bg-brand-muted text-brand"
                aria-hidden="true"
              >
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </div>

              <div>
                <h4 class="mb-1 text-sm font-bold text-ink-primary">
                  {benefit.title}
                </h4>
                <p class="text-sm leading-relaxed text-ink-secondary">
                  {benefit.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-8 flex items-start gap-3 rounded-xl
             border border-warning/20 bg-warning/8 p-5"
      role="note"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#92400E"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="mt-0.5 flex-shrink-0"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <line x1="12" y1="16" x2="12.01" y2="16" />
      </svg>

      <div>
        <h4 class="mb-1 text-sm font-bold text-ink-primary">
          Informasi Harga dan Pemeliharaan
        </h4>

        <p class="text-sm leading-relaxed text-ink-secondary">
          Harga paket merupakan harga awal sesuai ruang lingkup yang tercantum.
          Penambahan halaman, fitur, integrasi, atau perubahan kebutuhan dapat
          memengaruhi harga. Domain dan hosting yang termasuk dalam paket
          berlaku sesuai periode yang disebutkan; biaya perpanjangan tahun
          berikutnya akan dikonfirmasikan sebelum layanan diperpanjang.
          Garansi bug dan pemeliharaan hanya berlaku sesuai durasi serta
          cakupan paket yang disepakati.
        </p>
      </div>
    </div>
  </div>
</section>
