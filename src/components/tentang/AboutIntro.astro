---
interface Props {
  profile: {
    name: string;
    photo: string;
  };
}

const { profile } = Astro.props;
---

<section class="bg-white py-16 lg:py-24" aria-labelledby="about-heading">
  <div class="container-custom grid items-center gap-10 lg:grid-cols-[1.25fr_0.75fr]">
    <div>
      <p class="mb-5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-brand">Tentang Web Inovasion</p>
      <h1 id="about-heading" class="max-w-3xl text-4xl font-extrabold leading-tight tracking-tight text-ink-primary lg:text-5xl">
        Halo, saya {profile.name || <span class="text-brand">Web Inovasion</span>}.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-secondary">
        Saya mengelola Web Inovasion dan membantu bisnis menjelaskan layanan, produk, kapabilitas, serta proyeknya melalui website.
      </p>
    </div>
    <div class="relative mx-auto w-full max-w-sm">
      <div class="absolute -bottom-4 -left-4 h-28 w-28 rounded-3xl bg-brand-light/20" aria-hidden="true"></div>
      {profile.photo ? (
        <img src={profile.photo} alt={`Foto ${profile.name || 'pemilik Web Inovasion'}`} class="relative aspect-[4/5] w-full rounded-2xl border border-surface-border object-cover shadow-card" />
      ) : (
        <div role="img" aria-label="Placeholder foto profil, belum diisi" class="relative flex aspect-[4/5] w-full items-center justify-center rounded-2xl border-2 border-dashed border-brand/30 bg-brand-muted p-8 text-center text-sm font-medium text-brand">
          Slot foto profil<br />TODO: tambahkan foto yang disetujui
        </div>
      )}
    </div>
  </div>
</section>
