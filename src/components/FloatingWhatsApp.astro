---
import { siteData } from '../data/site';

const phone = siteData.contact.phone.replace(/\D/g, '');
const message = encodeURIComponent('Halo Web Inovasion, saya ingin konsultasi tentang pembuatan website.');
const href = `https://wa.me/${phone}?text=${message}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Konsultasi melalui WhatsApp"
  aria-hidden="true"
  inert
  data-floating-whatsapp
  class="fixed bottom-[calc(env(safe-area-inset-bottom)+1rem)] right-4 z-40 inline-flex translate-y-3 items-center gap-2 rounded-full bg-brand px-4 py-3 text-sm font-bold text-white opacity-0 shadow-lg shadow-brand/20 transition duration-300 hover:-translate-y-0.5 hover:bg-brand-hover hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2 motion-reduce:transition-none sm:right-6"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M20.52 3.48A11.9 11.9 0 0 0 12.04 0C5.45 0 .09 5.35.09 11.94c0 2.1.55 4.14 1.6 5.95L0 24l6.27-1.64a11.9 11.9 0 0 0 5.76 1.47h.01c6.58 0 11.94-5.36 11.94-11.95 0-3.19-1.24-6.18-3.46-8.4ZM12.04 21.8h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.72.97.99-3.63-.24-.37a9.9 9.9 0 0 1-1.52-5.24c0-5.46 4.45-9.9 9.91-9.9a9.83 9.83 0 0 1 7.01 2.9 9.85 9.85 0 0 1 2.9 7.02c0 5.46-4.45 9.91-9.92 9.91Zm5.44-7.42c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.23-.65.08-.3-.15-1.26-.46-2.4-1.46-.89-.8-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.08-.79.37-.27.3-1.04 1.01-1.04 2.47 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.3 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.08 1.75-.72 2-1.42.25-.7.25-1.3.18-1.42-.08-.13-.28-.2-.58-.35Z" />
  </svg>
  <span>Konsultasi</span>
</a>

<script>
  const floatingWhatsApp = document.querySelector<HTMLAnchorElement>('[data-floating-whatsapp]');
  const contactSection = document.querySelector<HTMLElement>('#contact');

  if (floatingWhatsApp) {
    let contactIsVisible = false;
    let scrollFrame = 0;

    const updateVisibility = () => {
      scrollFrame = 0;
      const shouldShow = window.scrollY > 240 && !contactIsVisible;

      floatingWhatsApp.classList.toggle('translate-y-3', !shouldShow);
      floatingWhatsApp.classList.toggle('opacity-0', !shouldShow);
      floatingWhatsApp.classList.toggle('pointer-events-none', !shouldShow);
      floatingWhatsApp.classList.toggle('opacity-100', shouldShow);
      floatingWhatsApp.setAttribute('aria-hidden', String(!shouldShow));
      floatingWhatsApp.inert = !shouldShow;
    };

    const scheduleVisibilityUpdate = () => {
      if (scrollFrame) return;
      scrollFrame = window.requestAnimationFrame(updateVisibility);
    };

    if (contactSection && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(([entry]) => {
        contactIsVisible = entry.isIntersecting;
        scheduleVisibilityUpdate();
      }, { threshold: 0.05 });

      observer.observe(contactSection);
    }

    window.addEventListener('scroll', scheduleVisibilityUpdate, { passive: true });
    window.addEventListener('resize', scheduleVisibilityUpdate);
    updateVisibility();
  }
</script>
