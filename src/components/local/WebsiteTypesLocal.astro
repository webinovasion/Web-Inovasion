---
import type { LocalPage } from '../../config/LocalPage';

interface Props {
  page: LocalPage;
}

const { page } = Astro.props;
const serviceIcons: Record<string, string> = {
  monitor: `<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>`,
  briefcase: `<rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V4h8v3M3 12h18M10 12v2h4v-2"/>`,
  zap: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>`,
  catalog: `<path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 4.5v17M8 6h8M8 10h8"/>`,
};
---

<section id="website-types" class="section-padding">
  <div class="container-custom">
    <div class="mx-auto max-w-3xl text-center">
      <span
        class="inline-flex items-center rounded-full
               border border-brand/20
               bg-brand/10
               px-4 py-1.5
               text-sm font-semibold
               text-brand"
      >
        Jenis Layanan
      </span>

      <h2 class="mt-5 text-3xl font-extrabold md:text-5xl">
        Pilih format website yang
        <span class="text-brand"> sesuai kebutuhan </span>
      </h2>

      <p class="mt-5 text-lg leading-relaxed text-ink-secondary">
        Berikut beberapa jenis website yang dapat dibahas untuk usaha Anda di Bekasi. Fitur akhir mengikuti materi dan ruang lingkup proyek.
      </p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {
        page.websiteTypes.map((item) => (
          <article
            class="group rounded-2xl
                   border border-surface-border
                   bg-surface-card
                   p-6
                   transition-all duration-300
                   hover:-translate-y-1
                   hover:border-brand/40
                   hover:shadow-lg"
          >
            <div
              class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-brand/10 text-brand"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={serviceIcons[item.icon] ?? serviceIcons.monitor} />
            </div>

            <h3 class="text-lg font-bold">{item.title}</h3>

            <p class="mt-3 text-sm leading-relaxed text-ink-secondary">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
