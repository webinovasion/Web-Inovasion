---
import type { LocalPage } from '../../config/LocalPage';

interface Props {
  page: LocalPage;
}

const { page } = Astro.props;

// SVG icon paths — reusable
const icons = {
  pin: `<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>`,
  arrowRight: `<line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>`,
  check: `<polyline points="20 6 9 17 4 12"/>`,
};
---

<section aria-labelledby="hero-local-heading" class="relative overflow-hidden bg-[#10131b] py-16 text-white lg:py-20">
  <!-- Background glow — dekoratif -->
  <div
    class="absolute left-1/2 top-0 h-[480px] w-[480px]
           -translate-x-1/2 rounded-full bg-brand-light/10 blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-custom relative z-[1]">
    <div class="grid gap-12 lg:grid-cols-[1fr_0.85fr] lg:items-center">
      <!-- LEFT -->
      <div>
        <span
          class="inline-flex items-center gap-1.5 rounded-full
                 border border-brand-light/20 bg-brand-light/10
                 px-4 py-[7px] text-sm font-medium text-brand-light"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={icons.pin}
          />
          {page.badge}
        </span>

        <h1
          id="hero-local-heading"
          class="mt-5 max-w-2xl text-4xl font-extrabold
                 leading-[1.08] tracking-tight text-white
                 sm:text-5xl lg:text-6xl"
        >
          {page.hero.title}
        </h1>

        <p class="mt-5 max-w-xl text-sm leading-relaxed sm:text-base
                  text-white/70">
          {page.hero.subtitle}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="#contact"
            class="inline-flex items-center gap-[7px] rounded-lg bg-brand px-5 py-3 text-sm
          font-semibold text-white transition-colors hover:bg-brand-hover"
          >
            {page.cta.primary.text}
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={icons.arrowRight}
            />
          </a>
          <a
            href={page.cta.secondary.href}
            class="inline-flex items-center gap-[7px] rounded-lg border border-white/25
        px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-brand-light hover:text-brand-light"
          >
            {page.cta.secondary.text}
          </a>
        </div>

        <p class="mt-6 text-sm leading-relaxed text-white/55">
          Konsultasi awal singkat melalui WhatsApp.
        </p>
      </div>

      <!-- RIGHT -->
      <div>
        <div class="rounded-2xl border border-white/10
                 bg-[#1b1e27] p-7 shadow-card">
          <div class="mb-[22px] flex items-start justify-between">
            <div>
              <p class="mb-1.5 text-[11px] font-bold uppercase
                        tracking-wider text-brand-light">
                Cakupan Layanan
              </p>
              <h2 class="text-[1.4rem] font-extrabold tracking-tight
                         text-white">
                {page.city}
              </h2>
            </div>

            <span
              class="whitespace-nowrap rounded-full bg-brand-light/10
                         px-2.5 py-1 text-[11px] font-bold text-brand-light"
            >
              Bekasi
            </span>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            {
              page.areas.map(({ heading }) => (
                <div
                  class="flex items-center gap-3 rounded-xl
                       border border-white/10 bg-white/[0.04]
                       px-4 py-4 text-sm font-semibold text-white/75"
                >
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="flex-shrink-0 text-brand-light"
                    aria-hidden="true"
                    set:html={icons.check}
                  />
                  {heading}
                </div>
              ))
            }
          </div>

          <div
            class="mt-[18px] flex items-center gap-[9px]
                      rounded-xl bg-brand-light/10 px-4 py-3.5"
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#0F766E"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="flex-shrink-0"
              aria-hidden="true"
              set:html={icons.pin}
            />
            <p class="text-[12.5px] leading-relaxed text-brand-light">
              Diskusi dan koordinasi proyek dapat dilakukan secara online.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
