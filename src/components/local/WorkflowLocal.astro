---
import type { LocalPage } from "../../config/LocalPage";

interface Props {
  page: LocalPage;
}

const { page } = Astro.props;
---

<section
  id="workflow"
  class="section-padding bg-surface-card"
>
  <div class="container-custom">

    <!-- Heading -->
    <div class="mx-auto max-w-3xl text-center">

      <span
        class="inline-flex items-center rounded-full
               border border-brand/20
               bg-brand/10
               px-4 py-1.5
               text-sm font-semibold
               text-brand"
      >
        Langkah Pengerjaan
      </span>

      <h2
        class="mt-5 text-3xl font-extrabold md:text-5xl"
      >
        Dari brief sampai website
        <span class="text-brand"> siap dipublikasikan </span>
      </h2>

      <p
        class="mt-5 text-lg leading-relaxed text-ink-secondary"
      >
        Anda mengetahui halaman, fitur, biaya, dan jadwal yang disepakati sebelum pengerjaan dimulai.
      </p>

    </div>

    <!-- Cards -->
    <div
      class="mt-16 grid gap-6 md:grid-cols-2 xl:grid-cols-3"
    >

      {
        page.workflow.map((item) => (

          <article
            class="group relative overflow-hidden
                   rounded-3xl
                   border border-surface-border
                   bg-surface-base
                   p-8
                   transition-all duration-300
                    hover:-translate-y-1
                    hover:border-brand/30
                    hover:shadow-card"
          >

            <!-- Step number -->
            <div
              class="mb-6 flex h-12 w-12 items-center justify-center
                     rounded-xl bg-brand text-lg font-bold text-white"
            >
              {item.step}
            </div>

            <h3
              class="text-xl font-bold"
            >
              {item.title}
            </h3>

            <p
              class="mt-3 leading-relaxed text-ink-secondary"
            >
              {item.description}
            </p>

          </article>

        ))
      }

    </div>

  </div>
</section>
