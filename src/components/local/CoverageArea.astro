---
import type { LocalPage } from '../../config/LocalPage';

interface Props {
  page: LocalPage;
}

const { page } = Astro.props;

const pinIcon = `<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>`;
---

<section id="areas" aria-labelledby="areas-heading" class="bg-surface-base py-20 lg:py-28">
  <div class="container-custom">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <p class="mb-4 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.16em] text-brand">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={pinIcon}
        />
        Jangkauan layanan
      </p>

      <h2
        id="areas-heading"
        class="text-3xl font-extrabold tracking-tight
               text-ink-primary lg:text-4xl"
      >
        Bisnis di Kota dan Kabupaten Bekasi
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-ink-secondary">
        Saya melayani kebutuhan bisnis di Kota dan Kabupaten Bekasi. Konsultasi awal dapat dilakukan singkat melalui WhatsApp.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-2 xl:grid-cols-3">
      {
        page.areas.map(({ heading, context, places }) => (
          <section class="rounded-2xl border border-surface-border bg-surface-raised p-6">
            <h3 class="text-xl font-bold text-ink-primary">{heading}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-secondary">{context}</p>
            <ul class="mt-5 flex flex-wrap gap-2" aria-label={`Cakupan ${heading}`}>
              {places.map((place) => <li class="rounded-full bg-surface-card px-3 py-1.5 text-xs font-medium text-ink-secondary">{place}</li>)}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>
