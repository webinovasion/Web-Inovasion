---
import type { LocalPage } from '../../config/LocalPage';

interface Props {
  page: LocalPage;
}

const { page } = Astro.props;

const pinIcon = `<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>`;
---

<section id="areas" aria-labelledby="areas-heading" class="py-20 lg:py-28 bg-surface-base">
  <div class="container-custom">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <span
        class="inline-flex items-center gap-1.5 rounded-full
               border border-brand-border bg-brand-muted
               px-4 py-1.5 text-sm font-semibold text-brand"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          set:html={pinIcon}
        />
        Jangkauan Layanan
      </span>

      <h2
        id="areas-heading"
        class="mt-5 text-3xl font-extrabold tracking-tight
               text-ink-primary md:text-4xl"
      >
        Bisnis di Kota dan Kabupaten Bekasi
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed
                text-ink-secondary">
        Konsultasi pembuatan website dapat dilakukan secara online melalui WhatsApp atau Google Meet. Anda tidak perlu datang ke kantor untuk membahas kebutuhan proyek.
      </p>
    </div>

    <div class="mx-auto flex max-w-2xl flex-wrap justify-center gap-3">
      {
        page.areas.map((area) => (
          <span
            class="inline-flex items-center gap-3 rounded-xl border border-surface-border
                   bg-surface-raised px-5 py-4 text-sm font-semibold text-ink-primary"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#0F766E"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={pinIcon}
            />
            {area}
          </span>
        ))
      }
    </div>

    <div class="mx-auto mt-8 flex max-w-2xl flex-col items-center gap-4 rounded-2xl border border-brand-border bg-brand-muted p-6 text-center sm:flex-row sm:justify-between sm:text-left">
      <p class="text-sm leading-relaxed text-ink-secondary">
        Berada di luar Bekasi? Koordinasi proyek juga dapat dilakukan secara online.
      </p>
      <a
        href={page.cta.primary.href}
        class="inline-flex shrink-0 items-center justify-center rounded-xl bg-brand px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-hover"
      >
        Tanyakan Kebutuhan Anda
      </a>
    </div>
  </div>
</section>
