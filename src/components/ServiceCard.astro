---
import { siteData } from '../data/site';

const icons: Record<string, string> = {
  monitor: `<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>`,
  zap: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>`,
  cart: `<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>`,
  code: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
  grid: `<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>`,
};

const services = siteData.services;
---

<section id="services" aria-labelledby="services-heading" class="bg-[#10131b] py-20 text-white lg:py-28">
  <div class="container-custom grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="mb-5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-brand-light">
        Layanan
      </p>
      <h2
        id="services-heading"
        class="mb-5 text-3xl font-extrabold leading-tight tracking-tight text-white lg:text-5xl"
      >
        Pilih Jenis Website yang Dibutuhkan
      </h2>
      <p class="max-w-lg text-base leading-relaxed text-white/65">
        Pilih format berdasarkan informasi yang perlu disampaikan dan tindakan yang ingin dilakukan pengunjung. Fitur
        dan isi akhir dapat dibahas bersama.
      </p>
      <p class="mt-7 max-w-lg border-l-2 border-brand-light/70 bg-white/[0.04] px-4 py-3 text-sm leading-relaxed text-white/70">
        Saya juga melayani UMKM dari berbagai bidang melalui paket{' '}
        <a href="/#harga" class="font-semibold text-brand-light underline underline-offset-4">
          Profil Bisnis
        </a>
        .
      </p>
    </div>

    <div class="divide-y divide-white/10 border-y border-white/10">
      {services.map((service, index) => (
        <article class="group grid grid-cols-[2rem_1fr] gap-x-4 py-6 sm:grid-cols-[2.5rem_1fr_auto] sm:gap-x-5 sm:py-7">
          <span class="pt-1 text-xs font-bold tracking-widest text-brand-light/70">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div>
            <div class="mb-2 flex items-center gap-3">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#14B8A6"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={icons[service.icon] ?? icons.code}
              />
              <h3 class="text-base font-bold text-white sm:text-lg">{service.name}</h3>
            </div>
            <p class="max-w-xl text-sm leading-relaxed text-white/65">{service.description}</p>
            <div class="mt-3 flex flex-wrap gap-x-3 gap-y-1.5">
              {service.tags.map((tag) => (
                <span class="text-[11px] font-medium text-white/45">{tag}</span>
              ))}
            </div>
          </div>
          <a
            href="#contact"
            class="col-start-2 mt-3 inline-flex items-center gap-2 text-xs font-semibold text-brand-light transition-[gap] duration-200 group-hover:gap-3 sm:col-start-3 sm:row-span-2 sm:row-start-1 sm:mt-1 sm:self-center"
          >
            Konsultasikan kebutuhan
            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
