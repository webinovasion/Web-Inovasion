---
import { siteData } from '../data/site';

const icons: Record<string, string> = {
  monitor: `<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>`,
  zap: `<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>`,
  cart: `<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>`,
  code: `<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>`,
  grid: `<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>`,
};

const services = siteData.services;
---

<section id="services" aria-labelledby="services-heading" class="bg-[#10131b] text-white">
  <div class="container-custom py-16 lg:py-20">
    <p class="mb-5 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-brand-light">
      Layanan
    </p>
    <div class="grid gap-6 lg:grid-cols-[1fr_0.8fr] lg:items-end lg:gap-12">
      <h2 id="services-heading" class="max-w-3xl text-3xl font-extrabold leading-tight tracking-tight text-white lg:text-5xl">
        Pilih Jenis Website yang Dibutuhkan
      </h2>
      <div>
        <p class="max-w-xl text-sm leading-relaxed text-white/65 sm:text-base">
          Pilih format berdasarkan informasi yang perlu disampaikan dan tindakan yang ingin dilakukan pengunjung. Fitur dan isi akhir dapat dibahas bersama.
        </p>
        <p class="mt-4 border-l-2 border-brand-light/70 pl-3 text-sm leading-relaxed text-white/70">
          Saya juga melayani UMKM dari berbagai bidang melalui paket <a href="/#harga" class="font-semibold text-brand-light underline underline-offset-4">Profil Bisnis</a>.
        </p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
    {services.map((service, index) => (
      <article class:list={[
        'group flex min-h-[340px] flex-col px-6 py-8 text-white transition-colors sm:min-h-[370px] sm:px-8 lg:min-h-[410px] lg:px-7 lg:py-9 xl:px-9',
        index === 0 ? 'bg-[#0F172A]' : index === 1 ? 'bg-[#1B1E27]' : index === 2 ? 'bg-[#115E59]' : 'bg-[#0F766E]',
      ]}>
        <div class="mb-8 flex items-start justify-between">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-white/10 text-brand-light">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[service.icon] ?? icons.code} />
          </div>
          <span class="text-xs font-bold tracking-[0.18em] text-white/50">0{index + 1}</span>
        </div>

        <h3 class="mb-3 text-xl font-bold tracking-tight text-white">{service.name}</h3>
        <p class="mb-5 text-sm leading-relaxed text-white/75">{service.description}</p>

        <div class="mb-7 flex flex-wrap gap-x-3 gap-y-1.5">
          {service.tags.map((tag) => <span class="text-[11px] font-medium text-white/60">{tag}</span>)}
        </div>

        <a href="#contact" class="mt-auto inline-flex items-center gap-2 text-xs font-bold text-white transition-[gap] duration-200 group-hover:gap-3">
          Konsultasikan Kebutuhan Anda
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </article>
    ))}
  </div>
</section>
