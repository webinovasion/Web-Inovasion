---
import { siteData } from '../data/site';

const currentYear = new Date().getFullYear();
const whatsappUrl = `https://wa.me/${siteData.contact.phone.replace('+', '')}`;
const socials = [
  {
    label: 'Instagram Web Inovasion',
    href: siteData.social.instagram,
    icon: `<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/>`,
  },
  {
    label: 'LinkedIn Web Inovasion',
    href: siteData.social.linkedin,
    icon: `<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>`,
  },
];
---

<footer class="bg-ink-primary text-ink-disabled">
  <div class="container-custom pt-14 pb-8">
    <div class="grid grid-cols-1 gap-10 border-b border-white/[0.07] pb-10 md:grid-cols-2 lg:grid-cols-4">
      <section>
        <a href="/" aria-label={siteData.name} class="mb-4 inline-flex items-center gap-2 text-lg font-extrabold tracking-tight text-white">
          <span class="h-2 w-2 rounded-full bg-brand-light" aria-hidden="true"></span>
          {siteData.name}
        </a>
        <p class="mb-4 text-sm leading-relaxed text-ink-muted">
          Saya membantu perusahaan teknik, industri, kontraktor, dan supplier menjelaskan bisnisnya melalui website.
        </p>
        <div class="flex gap-2">
          {socials.map(({ label, href, icon }) => (
            <a href={href} target="_blank" rel="noopener noreferrer me" aria-label={label} class="flex h-9 w-9 items-center justify-center rounded-lg border border-white/[0.08] bg-white/[0.04] text-ink-muted transition hover:border-brand-light/40 hover:text-brand-light">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icon} />
            </a>
          ))}
        </div>
      </section>

      <nav aria-label="Layanan">
        <p class="mb-4 text-xs font-bold uppercase tracking-widest text-white">Layanan</p>
        <ul class="space-y-2.5">
          {siteData.services.map(({ name }) => (
            <li><a href="/#services" class="text-sm text-ink-muted transition-colors hover:text-brand-light">{name}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Navigasi footer">
        <p class="mb-4 text-xs font-bold uppercase tracking-widest text-white">Jelajahi</p>
        <ul class="space-y-2.5">
          {siteData.navigation.map(({ href, label }) => (
            <li><a href={href} class="text-sm text-ink-muted transition-colors hover:text-brand-light">{label}</a></li>
          ))}
        </ul>
      </nav>

      <section>
        <p class="mb-4 text-xs font-bold uppercase tracking-widest text-white">Kontak</p>
        <ul class="mb-6 space-y-2.5">
          <li><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-ink-muted transition-colors hover:text-brand-light">WhatsApp</a></li>
          <li><a href={`mailto:${siteData.contact.email}`} class="text-sm text-ink-muted transition-colors hover:text-brand-light">{siteData.contact.email}</a></li>
        </ul>
        <p class="mb-2 text-xs font-bold uppercase tracking-widest text-white">Lokasi</p>
        <address class="not-italic text-sm leading-relaxed text-ink-muted">{siteData.contact.location}</address>
      </section>
    </div>

    <div class="flex flex-col items-start justify-between gap-3 pt-7 sm:flex-row sm:items-center">
      <p class="text-xs text-ink-muted">© {currentYear} <span class="font-medium text-brand-light">{siteData.name}</span>. Semua hak dilindungi.</p>
      <p class="text-[11px] text-slate-600">Website untuk bisnis</p>
    </div>
  </div>
</footer>
