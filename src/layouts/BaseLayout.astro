---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import '../styles/global.css';

import { siteData } from '../data/site';
import { createSchema } from '../config/Schema';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  areaServed?: string | readonly string[];
}

const {
  title = siteData.defaultTitle,
  description = siteData.defaultDescription,
  canonical,
  ogImage = siteData.defaultOgImage,
  noindex = false,
  areaServed,
} = Astro.props;

const site = Astro.site ?? new URL(siteData.url);

const canonicalURL = new URL(canonical ?? Astro.url.pathname, site);
if (!canonicalURL.pathname.endsWith('/')) canonicalURL.pathname += '/';

const ogImageURL = new URL(ogImage, site);

const schema = createSchema({
  title,
  description,
  url: canonicalURL.href,
  image: ogImage,
  ...(areaServed ? { areaServed } : {}),
});
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content={description} />

    <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large'} />

    <meta name="author" content={siteData.author} />

    <meta name="generator" content={Astro.generator} />

    <meta name="theme-color" content={siteData.themeColor} />

    <meta name="format-detection" content="telephone=no" />

    <!-- Open Graph -->

    <meta property="og:type" content="website" />

    <meta property="og:url" content={canonicalURL} />

    <meta property="og:title" content={title} />

    <meta property="og:description" content={description} />

    <meta property="og:image" content={ogImageURL} />

    <meta property="og:image:type" content="image/png" />

    <meta property="og:image:width" content="1200" />

    <meta property="og:image:height" content="630" />

    <meta property="og:image:alt" content={siteData.name} />

    <meta property="og:locale" content={siteData.locale.replace('-', '_')} />

    <meta property="og:site_name" content={siteData.name} />

    <!-- Twitter -->

    <meta name="twitter:card" content="summary_large_image" />

    <meta name="twitter:title" content={title} />

    <meta name="twitter:description" content={description} />

    <meta name="twitter:image" content={ogImageURL} />

    <!-- Canonical -->

    <link rel="canonical" href={canonicalURL} />

    <!-- Icons -->

    <link rel="icon" href={siteData.logo} />

    <link rel="shortcut icon" href={siteData.logo} />

    <link rel="apple-touch-icon" href={siteData.logo} />

    <!-- Schema -->

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Google Analytics -->

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteData.analyticsId}`}></script>

    <script is:inline define:vars={{ ga: siteData.analyticsId }}>
      window.dataLayer = window.dataLayer || [];

      function gtag(...args) {
        window.dataLayer.push(args);
      }

      gtag('js', new Date());
      gtag('config', ga);
    </script>

    <title>{title}</title>
  </head>

  <body class="bg-surface-base font-sans antialiased text-ink-primary">
    <slot />

    <Analytics />

    <SpeedInsights />

    <script>
      type EventData = Record<string, string | number>;

      function trackEvent(name: string, data: EventData = {}) {
        window.dispatchEvent(new CustomEvent('webinovasion:track', { detail: { name, data } }));

        const analyticsWindow = window as Window & {
          gtag?: (command: 'event', eventName: string, eventData: EventData) => void;
        };
        analyticsWindow.gtag?.('event', name, data);
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest('a[href*="wa.me"], a[href*="api.whatsapp.com"]');
        if (link instanceof HTMLAnchorElement) trackEvent('whatsapp_click');
      });

      document.addEventListener('submit', (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || form.id !== 'contactForm') return;

        const formData = new FormData(form);
        trackEvent('contact_form_submit', {
          service: String(formData.get('service') ?? ''),
          budget: String(formData.get('budget') ?? '') || 'Belum ditentukan',
        });
      });
    </script>
  </body>
</html>
