---
import BaseLayout from '../layouts/BaseLayout.astro';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import HeroLocal from '../components/local/HeroLocal.astro';
import BenefitsLocal from '../components/local/BenefitsLocal.astro';
import CoverageArea from '../components/local/CoverageArea.astro';
import Services from '../components/ServiceCard.astro';
import Pricing from '../components/Pricing.astro';
import Workflow from '../components/Workflow.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Contact from '../components/Contact.astro';

import { localPages } from '../config/LocalPage';

const page = localPages.bekasi;
---

<BaseLayout title={page.title} description={page.description} areaServed={["Kota Bekasi", "Kabupaten Bekasi"]}>
  <Header />

  <main>
    <HeroLocal page={page} />

    <BenefitsLocal page={page} />

    <Services />

    <Pricing />

    <Workflow />

    <CoverageArea page={page} />

    <FAQ pagePath={`/${page.slug}`} />

    <CTA />

    <Contact />
  </main>

  <Footer />
</BaseLayout>
