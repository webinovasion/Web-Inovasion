---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteData } from "../data/site";

const title = "Tentang Saya | Web Inovasion";
const description = "Kenali freelancer di balik Web Inovasion dan fokus pembuatan website untuk perusahaan teknik, industri, kontraktor, dan supplier.";
const profile = siteData.profile;
---

<BaseLayout title={title} description={description}>
  <Header ctaHref="/#contact" />
  <main>
    <section class="bg-hero py-16 lg:py-24" aria-labelledby="about-heading">
      <div class="container-custom grid items-center gap-10 lg:grid-cols-[1.25fr_0.75fr]">
        <div>
          <p class="mb-4 text-xs font-bold uppercase tracking-widest text-brand">Tentang saya</p>
          <h1 id="about-heading" class="max-w-3xl text-4xl font-extrabold leading-tight tracking-tight text-ink-primary lg:text-5xl">
            Halo, saya {profile.name || <span class="text-brand">[TODO: isi nama]</span>}.
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-secondary">
            Saya mengelola Web Inovasion dan membantu bisnis menjelaskan layanan, produk, kapabilitas, serta proyeknya melalui website.
          </p>
        </div>
        {profile.photo ? (
          <img src={profile.photo} alt={`Foto ${profile.name || 'pemilik Web Inovasion'}`} class="aspect-square w-full max-w-sm rounded-3xl object-cover" />
        ) : (
          <div role="img" aria-label="Placeholder foto profil, belum diisi" class="flex aspect-square w-full max-w-sm items-center justify-center rounded-3xl border-2 border-dashed border-brand/30 bg-brand-muted p-8 text-center text-sm font-medium text-brand">
            Slot foto profil<br />TODO: tambahkan foto yang disetujui
          </div>
        )}
      </div>
    </section>

    <section class="py-16 lg:py-20" aria-labelledby="background-heading">
      <div class="container-custom grid gap-10 lg:grid-cols-2">
        <div>
          <p class="mb-3 text-xs font-bold uppercase tracking-widest text-brand">Latar belakang</p>
          <h2 id="background-heading" class="mb-4 text-3xl font-extrabold tracking-tight text-ink-primary">Perkenalan singkat</h2>
          {profile.background ? (
            <p class="leading-relaxed text-ink-secondary">{profile.background}</p>
          ) : (
            <p class="rounded-xl border border-dashed border-surface-border p-5 text-sm leading-relaxed text-ink-muted">TODO: isi latar belakang dan pengalaman saya sebelum halaman dipublikasikan.</p>
          )}
        </div>
        <div class="rounded-2xl border border-brand-border bg-brand-muted/50 p-6 lg:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-widest text-brand">Fokus keahlian</p>
          <h2 class="mb-4 text-2xl font-extrabold tracking-tight text-ink-primary">Perusahaan teknik dan industri</h2>
          {/* TODO: tinjau draf alasan fokus ini dan ubah jika tidak sesuai pengalaman pribadi. */}
          <p class="leading-relaxed text-ink-secondary">
            Saya ingin membantu perusahaan teknik, kontraktor, dan supplier menampilkan layanan, kapabilitas, produk, serta proyek dengan lebih terstruktur. Informasi yang jelas membantu calon klien dan mitra memahami kecocokan bisnis sebelum menghubungi perusahaan.
          </p>
        </div>
      </div>
    </section>

    <section class="bg-surface-raised py-16 lg:py-20" aria-labelledby="principles-heading">
      <div class="container-custom">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-brand">Prinsip kerja</p>
        <h2 id="principles-heading" class="mb-8 text-3xl font-extrabold tracking-tight text-ink-primary">Ekspektasi jelas sejak awal</h2>
        <ul class="grid gap-5 md:grid-cols-3">
          {[
            ["Lingkup disepakati", "Halaman, fitur, materi, revisi, dan biaya dibahas sebelum pengerjaan."],
            ["Informasi yang berguna", "Isi website disusun agar calon pelanggan memahami bisnis dan cara menghubunginya."],
            ["Klaim tetap realistis", "Saya menjelaskan pekerjaan yang dilakukan tanpa menjanjikan peringkat pencarian atau hasil yang belum terukur."],
          ].map(([heading, body]) => (
            <li class="rounded-2xl border border-surface-border bg-surface-base p-6">
              <h3 class="mb-2 font-bold text-ink-primary">{heading}</h3>
              <p class="text-sm leading-relaxed text-ink-secondary">{body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="py-16 lg:py-20" aria-labelledby="process-heading">
      <div class="container-custom grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p class="mb-3 text-xs font-bold uppercase tracking-widest text-brand">Proses kerja</p>
          <h2 id="process-heading" class="mb-4 text-3xl font-extrabold tracking-tight text-ink-primary">Dari diskusi sampai tayang</h2>
          <a href="/#portfolio" class="inline-flex font-semibold text-brand">Lihat contoh proyek <span class="ml-2" aria-hidden="true">→</span></a>
        </div>
        <ol class="space-y-4">
          {[
            "Diskusikan tujuan website dan kebutuhan bisnis.",
            "Sepakati paket, materi, lingkup, biaya, dan jadwal.",
            "Saya kerjakan website dan menyiapkan revisi sesuai paket.",
            "Website ditayangkan dan panduan diberikan sesuai fitur yang dibuat.",
          ].map((step, index) => (
            <li class="flex gap-4 rounded-xl border border-surface-border p-4">
              <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-brand-muted text-sm font-bold text-brand">{index + 1}</span>
              <span class="self-center text-sm leading-relaxed text-ink-secondary">{step}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="bg-brand py-14 text-white" aria-labelledby="about-cta-heading">
      <div class="container-custom flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
        <div>
          <h2 id="about-cta-heading" class="text-2xl font-extrabold">Ceritakan kebutuhan website Anda</h2>
          <p class="mt-2 text-sm text-white/80">Saya bantu membahas lingkup yang sesuai dengan bisnis Anda.</p>
        </div>
        <a href="/#contact" class="rounded-xl bg-white px-5 py-3 text-sm font-bold text-brand transition hover:bg-teal-50">Hubungi saya</a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
