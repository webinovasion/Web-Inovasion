---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import projects from "../data/Projects.json";

const title = "Tentang Saya | Web Inovasion";
const description = "Kenali orang di balik Web Inovasion dan pendekatan pembuatan website untuk UMKM, perusahaan teknik, dan bisnis.";
---

<BaseLayout title={title} description={description}>
  <Header ctaHref="/#contact" />
  <main>
    <section class="bg-hero py-20 lg:py-28">
      <div class="container-custom max-w-4xl">
        <p class="mb-4 text-xs font-bold uppercase tracking-widest text-brand">Tentang</p>
        <h1 class="max-w-3xl text-4xl font-extrabold leading-tight tracking-tight text-ink-primary lg:text-5xl">
          Website yang membantu bisnis menjelaskan dirinya dengan lebih jelas.
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-secondary">
          Saya mengelola Web Inovasion untuk membantu UMKM dan perusahaan memperkenalkan usaha, layanan, produk,
          dan proyeknya melalui website. Saya terbuka membantu berbagai bidang, dengan pengalaman proyek di perusahaan teknik dan industri.
        </p>
        <a href="/#contact" class="mt-8 inline-flex rounded-xl bg-brand px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-hover">
          Diskusikan kebutuhan website
        </a>
      </div>
    </section>

    <section class="py-16 lg:py-20">
      <div class="container-custom grid gap-10 lg:grid-cols-[1fr_1fr]">
        <div>
          <p class="mb-3 text-xs font-bold uppercase tracking-widest text-brand">Yang saya kerjakan</p>
          <h2 class="mb-4 text-3xl font-extrabold tracking-tight text-ink-primary">Website sesuai kebutuhan bisnis</h2>
          <p class="leading-relaxed text-ink-secondary">
            Kebutuhan tiap usaha berbeda. Ada yang perlu profil bisnis ringkas, ada yang perlu company profile untuk
            menjelaskan layanan dan proyek, dan ada yang membutuhkan katalog yang dapat dikelola melalui dashboard.
            Saya menyepakati isi serta fitur sebelum pengerjaan agar lingkupnya jelas.
          </p>
        </div>
        <div class="rounded-2xl border border-surface-border bg-surface-raised p-6 lg:p-8">
          <h2 class="mb-5 text-xl font-bold text-ink-primary">Cara kerja</h2>
          <ol class="space-y-4">
            {[
              "Diskusikan tujuan website dan kebutuhan bisnis.",
              "Sepakati paket, materi, lingkup, biaya, dan jadwal.",
              "Kerjakan website dan tinjau hasil sesuai putaran revisi paket.",
              "Tayangkan website dan berikan panduan sesuai fitur yang dibuat.",
            ].map((step, index) => (
              <li class="flex gap-3 text-sm leading-relaxed text-ink-secondary">
                <span class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-brand-muted text-xs font-bold text-brand">{index + 1}</span>
                <span>{step}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="bg-surface-raised py-16 lg:py-20" aria-labelledby="about-projects-heading">
      <div class="container-custom">
        <p class="mb-3 text-xs font-bold uppercase tracking-widest text-brand">Pengalaman proyek</p>
        <h2 id="about-projects-heading" class="mb-8 text-3xl font-extrabold tracking-tight text-ink-primary">Contoh proyek yang pernah saya kerjakan</h2>
        <div class="grid gap-5 md:grid-cols-2">
          {projects.map((project) => (
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="rounded-2xl border border-surface-border bg-surface-base p-6 transition hover:border-brand/40">
              <span class="text-xs font-semibold uppercase tracking-wide text-brand">{project.category}</span>
              <h3 class="mt-2 text-xl font-bold text-ink-primary">{project.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-secondary">{project.description}</p>
              <span class="mt-5 inline-flex text-sm font-semibold text-brand">Kunjungi website →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
