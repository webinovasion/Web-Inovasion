---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from '../components/CTA.astro';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AboutIntro from "../components/tentang/AboutIntro.astro";
import AboutBackground from "../components/tentang/AboutBackground.astro";
import AboutField from "../components/tentang/AboutField.astro";
import AboutVisionMission from "../components/tentang/AboutVisionMission.astro";
import AboutPrinciples from "../components/tentang/AboutPrinciples.astro";
import { siteData } from "../data/site";

const title = "Tentang Saya | Web Inovasion";
const description = "Kenali Web Inovasion, layanan pembuatan website untuk perusahaan teknik, industri, kontraktor, dan supplier, beserta visi dan misinya.";
const profile = siteData.profile;
---

<BaseLayout title={title} description={description}>
  <Header ctaHref="/#contact" />
  <main>
    <AboutIntro profile={profile} />
    <AboutBackground profile={profile} />
    <AboutField />
    <AboutVisionMission />
    <AboutPrinciples />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
